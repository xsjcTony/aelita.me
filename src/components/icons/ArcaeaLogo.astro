---
import { Image } from 'astro:assets'
import arcaeaLogo from '@assets/images/arcaea-logo.png'


type Props = {
  'class'?: string
  height: number
}


const { 'class': className, height } = Astro.props
---


<Image
  alt="arcaea logo"
  class={className}
  height={height}
  loading="eager"
  src={arcaeaLogo}
/>
