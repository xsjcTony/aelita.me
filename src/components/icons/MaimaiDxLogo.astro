---
import { Image } from 'astro:assets'
import maimaiDxLogo from '~assets/images/maimai-dx-logo.webp'


type Props = {
  'class'?: string
  height: number
}


const { 'class': className, height } = Astro.props
---


<Image
  alt="maimai dx logo"
  class={className}
  height={height}
  loading="eager"
  src={maimaiDxLogo}
/>
