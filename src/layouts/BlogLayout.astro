---
import type { Metadata } from '~layouts/Layout.astro'
import PageLayout from '~layouts/PageLayout.astro'


type Props = {
  metadata: Metadata
}


const { metadata } = Astro.props
---


<PageLayout metadata={metadata}>
  <div class="container-blog">
    <slot />
  </div>

  <!-- Rose twilight glow background -->
  <div
    class="fixed inset-0 -z-1 pointer-events-none"
    style={{
      background: 'radial-gradient(ellipse 80% 60% at 50% 0%, rgba(244, 114, 182, 0.25), transparent 70%), var(--color-bg-blog)',
    }}
  />
</PageLayout>
