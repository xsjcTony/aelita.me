---
import type { Metadata } from '~layouts/Layout.astro'
import BlogLayout from '~layouts/BlogLayout.astro'
import BlogList from '~pages/blogs/_components/BlogList'
import { getBlogs } from '~utils/content'


const metadata: Metadata = {
  title: 'Blog',
  description: `Tony's blog posts`,
}


const blogs = await getBlogs()
---


<BlogLayout metadata={metadata}>
  <h1 class="mb-60 text-h2 font-bold text-center text-fg-lighter lg:mb-80">Blog</h1>

  <BlogList client:load blogs={blogs} />
</BlogLayout>
