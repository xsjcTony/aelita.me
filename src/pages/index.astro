---
import type { Metadata } from '@layouts/Layout.astro'
import Squares from '@components/Squares.astro'
import PageLayout from '@layouts/PageLayout.astro'
import HeroSection from '@pages/_components/HeroSection'
import ArcaeaLogo from '@pages/_components/icons/ArcaeaLogo.astro'
import AstroLogo from '@pages/_components/icons/AstroLogo.astro'
import MaimaiDxLogo from '@pages/_components/icons/MaimaiDxLogo.astro'
import ViteLogo from '@pages/_components/icons/ViteLogo.astro'


const metadata: Metadata = { title: false }
---


<PageLayout metadata={metadata}>
  <!-- Hero section -->
  <div class="relative isolate">
    <!-- Squares effect -->
    <Squares />

    <HeroSection client:load>
      <AstroLogo slot="astro-logo" />
      <ViteLogo slot="vite-logo" />
      <ArcaeaLogo slot="arcaea-logo" />
      <MaimaiDxLogo slot="maimai-dx-logo" />
    </HeroSection>
  </div>
</PageLayout>
