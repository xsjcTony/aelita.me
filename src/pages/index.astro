---
import type { Metadata } from '@layouts/Layout.astro'
import ArcaeaLogo from '@components/icons/ArcaeaLogo.astro'
import AstroLogo from '@components/icons/AstroLogo.astro'
import MaimaiDxLogo from '@components/icons/MaimaiDxLogo.astro'
import ViteLogo from '@components/icons/ViteLogo.astro'
import Squares from '@components/Squares.astro'
import PageLayout from '@layouts/PageLayout.astro'
import HeroSection from '@pages/_components/HeroSection'
import MyJourney from '@pages/_components/MyJourney'


const metadata: Metadata = { title: false }
---


<PageLayout metadata={metadata}>
  <!-- Hero section -->
  <div class="relative isolate">
    <!-- Squares effect -->
    <Squares />

    <HeroSection client:load>
      <AstroLogo class="translate-y-2" slot="astro-logo" />
      <ViteLogo slot="vite-logo" />
      <ArcaeaLogo slot="arcaea-logo" />
      <MaimaiDxLogo slot="maimai-dx-logo" />
    </HeroSection>
  </div>


  <!-- My Journey -->
  <MyJourney client:load />
</PageLayout>
