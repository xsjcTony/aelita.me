---
import type { Metadata } from '~layouts/Layout.astro'
import ArcaeaLogo from '~components/icons/ArcaeaLogo.astro'
import MaimaiDxLogo from '~components/icons/MaimaiDxLogo.astro'
import PageLayout from '~layouts/PageLayout.astro'
import Squares from '~pages/_components/Squares.astro'
import HeroSection from '~pages/_views/HeroSection'
import MyJourney from '~pages/_views/MyJourney'
import Projects from '~pages/_views/Projects'
import TechStack from '~pages/_views/TechStack'


const metadata: Metadata = { title: false }
---


<PageLayout metadata={metadata}>
  <!-- Hero section -->
  <div class="relative isolate">
    <!-- Squares effect -->
    <Squares />

    <HeroSection client:load transition:persist>
      <ArcaeaLogo height={28} slot="arcaea-logo" />
      <MaimaiDxLogo height={28} slot="maimai-dx-logo" />
    </HeroSection>
  </div>


  <!-- My Journey -->
  <MyJourney client:load transition:persist />


  <!-- Tech Stack -->
  <TechStack client:load transition:persist />


  <!-- Projects -->
  <Projects client:load transition:persist />
</PageLayout>
