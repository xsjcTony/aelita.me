---
import type { Metadata } from '@layouts/Layout.astro'
import Squares from '@components/Squares.astro'
import TextRevealing from '@components/TextRevealing'
import PageLayout from '@layouts/PageLayout.astro'


const metadata: Metadata = { title: false }
---


<PageLayout metadata={metadata}>
  <div class="relative isolate">
    <!-- Squares effect -->
    <Squares />
    <div class="container py-80">
      <div class="flex justify-center">
        <TextRevealing client:load baseText="Aelita" revealedText="Tony Jiang" />
      </div>
    </div>
  </div>
</PageLayout>
