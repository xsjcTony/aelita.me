{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "~assets/*": ["src/assets/*"],
      "~components/*": ["src/components/*"],
      "~constants/*": ["src/constants/*"],
      "~hooks/*": ["src/hooks/*"],
      "~layouts/*": ["src/layouts/*"],
      "~pages/*": ["src/pages/*"],
      "~styles/*": ["src/styles/*"],
      "~utils/*": ["src/utils/*"],
    },
  },
}
